# Ningún paquete ejecuta scripts al instalarse (cadena de suministro).
ignore-scripts=true
# Versiones exactas al añadir dependencias.
save-exact=true
# Solo el registro oficial.
registry=https://registry.npmjs.org/
# Sin informe de auditoría en cada instalación: el build revisa solo lo que va dentro de la app
# (npm audit --omit=dev). Las herramientas de desarrollo se revisan aparte con `npm audit`.
audit=false
fund=false
