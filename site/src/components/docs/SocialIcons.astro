---
// The guide's header: a download button next to the GitHub and Discord icons, in the page's language.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { DOWNLOAD, pick } from "../landing/data";

const t = pick(Astro.locals.starlightRoute.locale ?? "");
---

<a class="rastro-download" href={DOWNLOAD}>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M2.5 13.5h11"></path>
  </svg>
  {t.downloadShort}
</a>
<Default />

<style>
  .rastro-download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.1rem;
    padding: 0 0.85rem;
    border-radius: 0.5rem;
    background: var(--rastro-amber);
    color: #1d1206;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .rastro-download:hover {
    background: var(--rastro-amber-hi);
    color: #1d1206;
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
