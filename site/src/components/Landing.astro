---
// The landing page, the same in every language. Text comes from src/i18n/landing.json (built from
// the READMEs' translations); screenshots from docs/images, copied by scripts/sync-docs.mjs.
// Each section is its own component in ./landing; this file is the page around them.
import "@fontsource-variable/ibm-plex-sans/wdth.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/landing.css";
import "../styles/landing-sections.css";
import "../styles/landing-features.css";
import "../styles/landing-start.css";
import "../styles/landing-footer.css";
import Hero from "./landing/Hero.astro";
import Reads from "./landing/Reads.astro";
import Showcase from "./landing/Showcase.astro";
import Start from "./landing/Start.astro";
import Footer from "./landing/Footer.astro";
import { DISCORD, GITHUB, links, pick } from "./landing/data";
import all from "../i18n/landing.json";

interface Props {
  slug: string;
}
const t = pick(Astro.props.slug);
const l = links(t.slug);
const description = `${t.pitchLead} ${t.pitchRest}`;
const ogImage = new URL(l.img("social-preview"), Astro.site).href;
// The credit names tarkov.dev once, as a link.
const credit = t.credit.split("tarkov.dev");
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c1517" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; base-uri 'self'; form-action 'none'"
    />
    <title>Rastro · {t.title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${l.base}favicon.svg`} />
    <link rel="canonical" href={new URL(l.home(t.slug), Astro.site).href} />
    {all.map((o) => <link rel="alternate" hreflang={o.lang} href={new URL(l.home(o.slug), Astro.site).href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Rastro · ${t.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body style={`--contours:url("${l.base}contours.svg")`}>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href={l.home(t.slug)}>
          <img src={`${l.base}favicon.svg`} alt="" width="26" height="26" />
          Rastro
        </a>
        <nav aria-label="Rastro">
          <a href={l.docs("features")}>{t.nav[0]}</a>
          <a href={l.docs("guide")}>{t.nav[1]}</a>
          <a href={l.docs("changelog")}>{t.nav[2]}</a>
          <a href={GITHUB}>GitHub</a>
        </nav>
        <details class="lang" data-menu>
          <summary aria-label={t.langLabel}>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <circle cx="8" cy="8" r="6.25" />
              <path d="M1.75 8h12.5M8 1.75c1.8 1.9 2.6 3.9 2.6 6.25S9.8 12.35 8 14.25C6.2 12.35 5.4 10.35 5.4 8S6.2 3.65 8 1.75Z" />
            </svg>
            {t.label}
          </summary>
          <ul>
            {
              all.map((o) => (
                <li>
                  <a href={l.home(o.slug)} lang={o.lang} aria-current={o.slug === t.slug ? "page" : undefined}>
                    {o.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <a class="button primary small-button" href={l.download}>{t.downloadShort}</a>
      </div>
    </header>

    <main>
      <Hero t={t} />
      <Reads t={t} />
      <Showcase t={t} />
      <Start t={t} />

      <section class="community" aria-labelledby="community">
        <div class="wrap community-inner">
          <h2 id="community">{t.communityTitle}</h2>
          <p class="body">{t.communityBody}</p>
          <div class="actions">
            <a class="button primary" href={DISCORD}>{t.discord}</a>
            <a class="button" href={GITHUB}>{t.source}</a>
          </div>
          <p class="credit">
            {credit[0]}<a href="https://tarkov.dev">tarkov.dev</a>{credit.slice(1).join("tarkov.dev")}
          </p>
        </div>
      </section>
    </main>

    <Footer t={t} />
    <script>
      import "../scripts/landing";
    </script>
  </body>
</html>
